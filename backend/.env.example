# AgentOps CRM Backend - Environment Variables Example
# Copy this file to .env and fill in actual values. Never commit .env.

# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database — local Docker Compose (docker/docker-compose.yml) publishes Postgres on 5433
DB_URL=jdbc:postgresql://127.0.0.1:5433/agentops_crm
DB_USER=postgres
DB_PASSWORD=postgres

# Redis is optional. Local Docker: docker compose -f docker/docker-compose.yml up -d redis
# REDIS_ENABLED=true
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Railway: link a Redis service so REDIS_URL is injected (auth rate limits + dashboard cache).

# AI Services
OPENAI_API_KEY=sk-...

# External Tools
FIRECRAWL_API_KEY=fc-...

# Resend — send approved PROFESSIONAL/FRIENDLY follow-ups. Domain must be verified in Resend.
# RESEND_API_KEY=re_...
# RESEND_FROM=AgentOps <hello@yourdomain.com>

# Fresh-lead notifications (optional). Telegram and Slack send the ping; Cal.com adds a booking link.
# CALCOM_BOOKING_URL=https://cal.com/you/15min
# CALCOM_API_KEY=cal_live_...
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# PUBLIC_FRONTEND_URL=http://localhost:5173

# Vapi Voice Call Integration (F-008)
VAPI_ENABLED=false
VAPI_API_KEY=your_vapi_api_key_here
VAPI_ASSISTANT_ID=your_assistant_id_here
# UUID of the Vapi phone number resource (not the E.164 number)
VAPI_PHONE_NUMBER_ID=your_phone_number_uuid_here
VAPI_WEBHOOK_SECRET=your_webhook_secret_here

# Apify Lead Finder (F-010)
APIFY_ENABLED=false
APIFY_API_TOKEN=your_apify_token_here
APIFY_DEFAULT_ACTOR_ID=compass~crawler-google-places

# Auth — use a long random value (openssl rand -base64 64). Never commit the real secret.
JWT_SECRET=change-this-demo-secret-to-a-long-random-value
JWT_EXPIRATION=86400000
APP_SECURITY_ENABLED=true
SHOWCASE_EXTERNAL_ACTIONS_DISABLED=false
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax
AUTH_SEED_DEMO_USER=true

# ---------------------------------------------------------------------------
# Railway production (set these in the Railway dashboard, not in git)
# ---------------------------------------------------------------------------
# SPRING_PROFILES_ACTIVE=prod
# PORT is injected by Railway
# JWT_SECRET=<openssl rand -base64 64>
# DB_URL=jdbc:postgresql://${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
# DB_USER=${{Postgres.PGUSER}}
# DB_PASSWORD=${{Postgres.PGPASSWORD}}
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# PUBLIC_BACKEND_URL=https://your-service.up.railway.app
# AUTH_SEED_DEMO_USER=true
# OPENAI_API_KEY=...
# REDIS_URL=${{Redis.REDIS_URL}}
# REDIS_ENABLED=true
# FIRECRAWL_API_KEY=...
# RESEND_API_KEY=...
# RESEND_FROM=AgentOps <hello@yourdomain.com>
# CALCOM_BOOKING_URL=https://cal.com/you/15min
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_CHAT_ID=...
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# PUBLIC_FRONTEND_URL=https://agent-ops-crm.vercel.app
# VAPI_ENABLED=true
# APIFY_ENABLED=true
