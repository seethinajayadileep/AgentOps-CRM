# Local Vite uses the /api proxy in vite.config.ts, so this is unused in `npm run dev`.
# Keep it so production-shaped configs and docs stay consistent.
VITE_API_BASE_URL=http://localhost:8080/api
VITE_APP_NAME=AgentOps CRM

# ---------------------------------------------------------------------------
# Vercel (set at BUILD time — Vite inlines this into the JS bundle)
# ---------------------------------------------------------------------------
# VITE_API_BASE_URL=https://your-service.up.railway.app/api
# After changing this variable, trigger a new Vercel deployment.
